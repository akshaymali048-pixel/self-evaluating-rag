# Application
APP_NAME=Self Evaluating RAG API
DEBUG=false
LOG_LEVEL=INFO

# LLM provider: openai | gemini
LLM_PROVIDER=openai

# OpenAI (default provider; required for upload/query/RAGAS when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini (optional; required only when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# PostgreSQL (use postgres host inside Docker Compose)
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5433/rag_eval

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=rag_chunks

# RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
UPLOAD_DIR=./data/uploads

# RAGAS / evaluation
HALLUCINATION_FAITHFULNESS_THRESHOLD=0.5
RAGAS_TIMEOUT_SECONDS=180
ENABLE_REFERENCE_METRICS=true
